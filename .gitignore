# Entornos virtuales y configuración local
venv/
.venv/
env/
.env
.env.*
!.env.example

# Cachés y archivos generados por Python
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Archivos del sistema y del editor
.DS_Store
.vscode/
.idea/

# Logs de ejecuciones y bases de datos locales
*.log
datos/resultados/logs/
*.sqlite3
*.db

# Estado en caliente del laboratorio (faults.yaml que escribe /admin/faults)
lab/runtime/

# Carga generada (reproducible con make lab-carga-datos) y salidas de k6
lab/carga/datos/
lab/carga/salida/

# Corridas de prueba del runner (make experimento-prueba)
evidencia/*/PRUEBA-*/
